<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mame4droid.Lobby</RootNamespace>
    <AssemblyName>Mame4droid.Lobby</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Workstation GC: the default server GC keeps a heap per core and is a
         poor fit for a small shared-CPU instance serving tiny JSON. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <!-- Build stamp, appended to InformationalVersion as "1.0.0+yyyyMMdd-HHmm".
         Nobody has to remember to bump anything: the value changes on every
         build, so the page and the startup line always name the running build.
         Local time on the machine that builds it: the point is to glance at
         the page and at your own clock and see the same thing. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <SourceRevisionId>$([System.DateTime]::Now.ToString(yyyyMMdd-HHmm))</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Same stamp the assembly carries, written next to the published files so
       it can be read without a server: compare it against what the home page
       says and you know whether the package you uploaded is the one running. -->
  <Target Name="WriteBuildStamp" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)build.txt" Overwrite="true"
                      Lines="build=$(VersionPrefix)+$(SourceRevisionId);published=$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss zzz'))" />
  </Target>

</Project>
