<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>
    <!-- The destination lives in the .csproj as LobbyPublishDir, so the button,
         the command line and this profile cannot drift apart. -->
    <PublishUrl>$(LobbyPublishDir)</PublishUrl>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <!-- Wipe the folder first: a file left behind from an older build is the
         same problem in miniature. -->
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
